{
  "uid": "ubichill-loadtest",
  "title": "Ubichill / Load test",
  "tags": [
    "ubichill",
    "loadtest"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Prometheus$/",
        "refresh": 1,
        "current": {},
        "options": [],
        "hide": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(ubichill_instance_active_rooms, namespace)",
        "query": {
          "query": "label_values(ubichill_instance_active_rooms, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "ubichill-dev",
          "value": "ubichill-dev"
        },
        "options": []
      },
      {
        "name": "testid",
        "label": "testid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(k6_vus, testid)",
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 2,
        "hide": 0,
        "multi": true,
        "includeAll": false,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "scale",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"$namespace\",horizontalpodautoscaler=~\"keda-hpa-.*-instance\"}[1m]) > 0",
        "titleFormat": "HPA の台数が変わった",
        "step": "30s"
      }
    ]
  },
  "panels": [
    {
      "id": 200,
      "type": "row",
      "title": "利用者（k6）",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "部屋に居る人数",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(k6_ubichill_joined_total{testid=~\"$testid\"}) - sum(k6_ubichill_left_total{testid=~\"$testid\"})",
          "legendFormat": "居る",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(k6_vus{testid=~\"$testid\"})",
          "legendFormat": "VU",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "world:snapshot まで届いた人 − 出た人"
    },
    {
      "id": 202,
      "type": "timeseries",
      "title": "カーソルの遅延（runner ごと、試験の始めからの累積）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance_id) (k6_ubichill_cursor_latency_p50{testid=~\"$testid\"})",
          "legendFormat": "p50 {{instance_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance_id) (k6_ubichill_cursor_latency_p95{testid=~\"$testid\"})",
          "legendFormat": "p95 {{instance_id}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance_id) (k6_ubichill_cursor_latency_p99{testid=~\"$testid\"})",
          "legendFormat": "p99 {{instance_id}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "部屋の 1 人目の cursor:move が 2 人目に届くまで。利用者の体感に最も近い値。累積なので途中の悪化は鈍く見える"
    },
    {
      "id": 203,
      "type": "timeseries",
      "title": "入室にかかる時間",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance_id) (k6_ubichill_join_duration_p95{testid=~\"$testid\"})",
          "legendFormat": "WS→snapshot p95 {{instance_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance_id) (k6_ubichill_ready_duration_p95{testid=~\"$testid\"})",
          "legendFormat": "開始→snapshot p95 {{instance_id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "ready はログイン・部屋を作る/探す・参加情報を含む"
    },
    {
      "id": 204,
      "type": "timeseries",
      "title": "状態を変える要求（/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (event, result) (rate(k6_ubichill_requests_total{testid=~\"$testid\"}[1m]))",
          "legendFormat": "{{event}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "migrating は引っ越し中の再試行、timeout・error は利用者から失敗に見えるもの"
    },
    {
      "id": 205,
      "type": "timeseries",
      "title": "入れなかった・切られた（累計）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (stage, reason) (k6_ubichill_join_failures_total{testid=~\"$testid\"})",
          "legendFormat": "入室失敗 {{stage}} {{reason}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (code) (k6_ubichill_disconnects_total{testid=~\"$testid\",by=\"server\"})",
          "legendFormat": "切断 {{code}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (code) (k6_ubichill_reconnects_total{testid=~\"$testid\"})",
          "legendFormat": "繋ぎ直し {{code}}",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (k6_ubichill_notices_total{testid=~\"$testid\"})",
          "legendFormat": "通知 {{kind}}",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 206,
      "type": "timeseries",
      "title": "API の応答時間 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (name) (k6_http_req_duration_p95{testid=~\"$testid\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(k6_http_req_failed_rate{testid=~\"$testid\"})",
          "legendFormat": "失敗率",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 207,
      "type": "timeseries",
      "title": "WebSocket のフレーム（/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(k6_ws_msgs_sent_total{testid=~\"$testid\"}[1m]))",
          "legendFormat": "送信",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(k6_ws_msgs_received_total{testid=~\"$testid\"}[1m]))",
          "legendFormat": "受信",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 208,
      "type": "timeseries",
      "title": "画面の体験（browser）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 8,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (step) (k6_ubichill_browser_step_duration_p95{testid=~\"$testid\"})",
          "legendFormat": "{{step}} p95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(k6_ubichill_browser_journey_duration_p95{testid=~\"$testid\"})",
          "legendFormat": "通し p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(k6_browser_web_vital_lcp_p95{testid=~\"$testid\"})",
          "legendFormat": "LCP p95",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "負荷の間に Chromium で ログイン→ロビー→入室→描画 を通した時間"
    },
    {
      "id": 209,
      "type": "timeseries",
      "title": "画面の通しの失敗（累計）",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (step) (k6_ubichill_browser_failures_total{testid=~\"$testid\"})",
          "legendFormat": "{{step}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Go の Pod",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pod ごとの WebSocket 接続",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (ubichill_instance_websocket_connections{namespace=\"$namespace\",service=~\".*-instance\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "中継は中継元と owner の両方で数える。利用者の数 = websocket - relay"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pod ごとの中継の接続",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 8,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (ubichill_instance_relay_connections{namespace=\"$namespace\",service=~\".*-instance\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Pod ごとの部屋",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (ubichill_instance_active_rooms{namespace=\"$namespace\",service=~\".*-instance\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
